# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Data files (raw datasets should not be tracked)
data/raw/*.csv
data/raw/*.zip
data/raw/*.xlsx
data/processed/*.csv

# Serialized model artifacts
models/*.pkl
models/*.joblib
models/*.onnx

# Environment secrets
.env
.env.local
*.env

# IDE and Editor configurations
.vscode/
.idea/
*.swp
*.swo

# Operating System artifacts
.DS_Store
Thumbs.db

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Pytest and coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Node.js and Next.js artifacts
frontend/nextjs/node_modules/
frontend/nextjs/.next/
frontend/nextjs/out/
frontend/nextjs/.turbo/
